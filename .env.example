# Copy this file to ".env" and fill in real values.
# ".env" itself is git-ignored and must never be committed.

# Which config class to build the app with: development | testing | production
CONFIG_NAME=development

# Used by Flask to sign sessions/cookies. Generate a real random value
# for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme

# Not used yet in Phase 0 — reserved for when we connect to MySQL.
# Example: mysql+pymysql://user:password@localhost:3306/insightflow
DATABASE_URL=
